{
  "name": "spectral-soundworks-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:csv": "node scripts/import-leads-from-csv.js",
    "backfill:enrich": "node scripts/backfill-enrich.js",
    "refresh:ig": "node scripts/refresh-ig-posts.js",
    "backfill:ig-images": "node scripts/backfill-ig-images.js",
    "ig:scrape": "node scripts/ig-profile-scraper.js",
    "score": "node scripts/score-leads.js",
    "score:auto": "node scripts/score-auto.js",
    "enrich:stale": "node scripts/enrich-stale.js",
    "enrich:analysis": "node scripts/enrich-analysis.js",
    "followup:remind": "node scripts/followup-remind.js",
    "sequences:seed": "node scripts/seed-sequences.js",
    "sequences:advance": "node scripts/advance-sequences.js",
    "discover:contacts": "node scripts/discover-contacts.js",
    "report:campaign": "node scripts/report-campaign.js",
    "detect:duplicates": "node scripts/detect-duplicates.js",
    "standardize:genres": "node scripts/standardize-genres.js",
    "send:messages": "node scripts/send-messages.js",
    "seed": "node prisma/seed.js",
    "seed:reset": "node prisma/seed.js --reset",
    "launch": "bash scripts/launch.sh",
    "db:backup": "docker exec spectral-postgres pg_dump -U postgres spectral > backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:migrate": "prisma migrate dev",
    "test": "node --test 'src/**/*.test.js'",
    "test:scrapers": "vitest run src/lib/scrapers/shared.test.ts src/lib/lead-enrichment-service.test.ts",
    "screen-production-needs": "node scripts/screen-production-needs.js"
  },
  "dependencies": {
    "@novu/api": "^3.16.0",
    "@novu/nextjs": "^3.16.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "apify-client": "^2.15.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.4.0",
    "jsdom": "^29.1.1",
    "next": "16.1.6",
    "nodemailer": "^6.9.13",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.19.40",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.16.0",
    "@types/pino": "^7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
